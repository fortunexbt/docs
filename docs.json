{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Fortune Field Manual",
  "description": "Architecture notes, measured results and reproduction steps for fortunexbt's projects.",
  "colors": {
    "primary": "#075985",
    "light": "#48EEFF",
    "dark": "#9C6CFF"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "IBM Plex Sans",
    "weight": 400,
    "heading": {
      "family": "IBM Plex Mono",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F4F7F6",
      "dark": "#09080B"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "vitesse-dark"
      }
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Projects",
        "icon": "radar",
        "groups": [
          {
            "group": "Start",
            "pages": [
              "index",
              "status"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "architecture/mutx",
              "architecture/bollard",
              "architecture/tablebeam",
              "architecture/boundary-bench",
              "architecture/queueglass",
              "architecture/world-watch",
              "architecture/minecraft-apple-silicon"
            ]
          },
          {
            "group": "Games",
            "pages": [
              "architecture/solar-drift",
              "architecture/loop-courier",
              "architecture/terminal-starfield",
              "architecture/ckitty"
            ]
          }
        ]
      },
      {
        "tab": "Recipes",
        "icon": "play",
        "groups": [
          {
            "group": "Reproduce one claim",
            "pages": [
              "recipes",
              "recipes/tablebeam-exact-answers",
              "recipes/boundary-bench-report",
              "recipes/mutx-operator-loop",
              "recipes/starfield-seeded-run",
              "recipes/ckitty-deterministic-frame"
            ]
          }
        ]
      },
      {
        "tab": "Proof",
        "icon": "shield-check",
        "groups": [
          {
            "group": "Proof",
            "pages": [
              "proof/build-and-release"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/fortunexbt",
          "icon": "github"
        },
        {
          "anchor": "MUTX docs",
          "href": "https://docs.mutx.dev",
          "icon": "activity"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/"
    },
    {
      "source": "/development",
      "destination": "/"
    },
    {
      "source": "/start-here",
      "destination": "/"
    },
    {
      "source": "/principles",
      "destination": "/"
    },
    {
      "source": "/principles/:slug*",
      "destination": "/"
    },
    {
      "source": "/essentials/:slug*",
      "destination": "/"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/"
    },
    {
      "source": "/api-reference/:slug*",
      "destination": "/architecture/mutx"
    },
    {
      "source": "/labs/status",
      "destination": "/status"
    },
    {
      "source": "/labs/solar-drift",
      "destination": "/architecture/solar-drift"
    },
    {
      "source": "/labs/loop-courier",
      "destination": "/architecture/loop-courier"
    },
    {
      "source": "/labs/queueglass",
      "destination": "/architecture/queueglass"
    },
    {
      "source": "/labs/:slug*",
      "destination": "/status"
    },
    {
      "source": "/recipes/tablebeam-source-trail",
      "destination": "/recipes/tablebeam-exact-answers"
    },
    {
      "source": "/recipes/index",
      "destination": "/recipes"
    }
  ],
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/fortunexbt"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Portfolio",
      "href": "https://fortunexbt.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/field-grid.svg",
    "fonts": {
      "family": "IBM Plex Mono"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/fortunexbt",
      "x": "https://x.com/fortunexbt"
    }
  }
}
